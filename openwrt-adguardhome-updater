    ui_ok "Architecture: ${cpu_arch} -> ${AGH_ARCH}"
    ui_ok "Free space in /tmp: ${FREE_MB} MB"

    printf '\n'
    ui_ok "Install directory: ${AGH_DIR}"
    ui_ok "Binary:            ${AGH_BINARY}"
    ui_ok "Config:            ${AGH_CONFIG:-not found}"
    ui_ok "Init script:       ${AGH_INIT}"

    printf '\n'
    ui_ok "Current version:   ${CURRENT_VERSION}"
    ui_ok "Configured channel: ${CHANNEL}"
    ui_ok "Detected build:    ${DETECTED_CHANNEL}"
    ui_ok "Latest version:    ${LATEST_VERSION} (${CHANNEL})"
    case "$LATEST_VERSION" in
        beta|edge|development)
            ui_warn "Exact ${CHANNEL} version could not be read. The updater will download the latest channel tarball."
            ;;
    esac
    if [ "$DETECTED_CHANNEL" != "unknown" ] && [ "$DETECTED_CHANNEL" != "$CHANNEL" ]; then
        ui_warn "Configured channel is ${CHANNEL}, but installed build looks like ${DETECTED_CHANNEL}."
    fi

    printf '\n'
    ui_ok "Prerequisites met."
