render_dashboard() {
    local model fw_ver lan_ip agh_ver now tz_posix gmt_label offset

    tz_posix="$(uci get system.@system[0].timezone 2>/dev/null || true)"
    gmt_label="UTC"
    if [ -n "$tz_posix" ]; then
        offset="$(printf '%s' "$tz_posix" | sed -n 's/^[A-Za-z]*\([+-][0-9]*\).*/\1/p')"
        if [ -n "$offset" ]; then
            case "$offset" in
                -*) gmt_label="GMT+${offset#-}" ;;
                +*) gmt_label="GMT-${offset#+}" ;;
                *)  gmt_label="GMT" ;;
            esac
        fi
        now="$(TZ="$tz_posix" date "+%a %b %d %Y %I:%M:%S %p $gmt_label" 2>/dev/null || true)"
    fi
    [ -n "$now" ] || now="$(date '+%a %b %d %Y %I:%M:%S %p UTC' 2>/dev/null || true)"
    [ -n "$now" ] || now="time-unavailable"

    model="$(cat /tmp/sysinfo/model 2>/dev/null || echo "unknown")"
    fw_ver="$(grep DISTRIB_RELEASE /etc/openwrt_release 2>/dev/null | cut -d= -f2 | tr -d '"')"
    [ -n "$fw_ver" ] || fw_ver="unknown"

    lan_ip="$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null | xargs -I{} ip -4 addr show {} 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')"
    [ -n "$lan_ip" ] || lan_ip="$(ip -4 addr show br-lan 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')"
    [ -n "$lan_ip" ] || lan_ip="unknown"

    agh_ver="$(${AGH_BINARY:-/etc/AdGuardHome/AdGuardHome} --version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    [ -n "$agh_ver" ] || agh_ver="unknown"

    local web_port
    web_port="$(get_web_port)"

    hr
    printf '\n'
    printf "  ${UI_TITLE}%s${C_RESET}\n" "$SCRIPT_NAME"
    printf '\n'
    printf "  Model:        %s\n" "$model"
    printf "  Firmware:     OpenWrt %s\n" "$fw_ver"
    printf "  LAN:          %s\n" "$lan_ip"
    printf "  AdGuardHome:  %s\n" "$agh_ver"
    printf "  Channel:      %s" "$CHANNEL"
    local detected
    detected="$(detect_channel_from_version "$agh_ver")"
    if [ "$detected" != "unknown" ] && [ "$detected" != "$CHANNEL" ]; then
        printf "  ${C_YELLOW}(installed build looks like: %s)${C_RESET}" "$detected"
    fi
    printf '\n'
    if [ -n "$lan_ip" ] && [ "$lan_ip" != "unknown" ]; then
        printf "  Web UI:       ${C_CYAN}http://%s:%s/${C_RESET}\n" "$lan_ip" "$web_port"
    fi
    printf "  Time:         %s\n" "$now"
    printf "  Theme:        %s\n" "$THEME_NAME"
    printf '\n'
}

show_about() {
    local backup_count agh_ver

    backup_count="$(ls -1 "${BACKUP_DIR}"/adguardhome-backup-*.tar.gz 2>/dev/null | wc -l | tr -d ' ')"
    agh_ver="$(${AGH_BINARY:-/etc/AdGuardHome/AdGuardHome} --version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    [ -n "$agh_ver" ] || agh_ver="unknown"

    hr
    printf '\n'
    ui_section_bar "About ${SCRIPT_NAME}"
    printf '\n'
    printf "  Script version: %s\n" "$SCRIPT_VERSION"
    printf "  AdGuardHome:    %s\n" "$agh_ver"
    printf "  Theme:          %s\n" "$THEME_NAME"
    printf "  State dir:      %s\n" "$STATE_DIR"
    printf "  Backups:        %s found in %s\n" "$backup_count" "$BACKUP_DIR"
    printf '\n'
    printf "${UI_HINT}%s${C_RESET}\n" "This script updates the AdGuardHome binary only."
    printf "${UI_HINT}%s${C_RESET}\n" "Config, blocklists, and query logs are never modified."
    printf "${UI_HINT}%s${C_RESET}\n" "Do not add this script to cron."
    printf '\n'
    is_tty || return 0
    printf "${UI_HINT}> Press Enter to return...${C_RESET}"
    read -r _DUMMY
}

show_theme_menu() {
    while true; do
        hr
        printf '\n'
        ui_section_bar "Theme Picker"
        printf '\n'
        ui_menu_item "1" "classic" "default"
        ui_menu_item "2" "green"
        ui_menu_item "3" "amber"
        ui_menu_item "4" "ocean"
        ui_menu_item "5" "mono" "no color"
        printf '\n'
        ui_menu_item "c" "cancel"
        printf '\n'
        printf "${C_CYAN}> Select theme [1-5 or c]: ${C_RESET}"
        read -r choice
        case "$choice" in
            1) THEME_NAME="classic" ;;
            2) THEME_NAME="green"   ;;
            3) THEME_NAME="amber"   ;;
            4) THEME_NAME="ocean"   ;;
            5) THEME_NAME="mono"    ;;
            c|C) return 0 ;;
            *) ui_warn "Please select 1-5 or c."; continue ;;
        esac
        theme_save
        theme_apply "$THEME_NAME"
        ui_ok "Theme set: ${THEME_NAME}"
        return 0
    done
}

reset_menu_defaults() {
    channel_load
    FORCE=0
    DRY_RUN=0
    ROLLBACK=0
    ROLLBACK_FILE=""
    LIST_BACKUPS=0
    DELETE_BACKUP=""
    MIGRATE_FROM_PACKAGE=0
    CONFIRMED_LAN=0
}

safe_detect_for_dashboard() {
    # Best-effort install detection so render_dashboard can show correct web port.
    # Never fatal, never prints errors.
    detect_agh_install >/dev/null 2>&1 || true
}

show_main_menu() {
    while true; do
        safe_detect_for_dashboard
        render_dashboard

        ui_section_bar "Update"
        ui_menu_item "1" "Update to latest stable (release)"
        ui_menu_item "2" "Update to latest beta" "not for production"
        ui_menu_item "3" "Update to latest edge" "development builds only"
        ui_menu_item "4" "Update to latest development" "highly experimental"
        ui_menu_item "5" "Force reinstall current channel version"
        ui_menu_item "6" "Dry run (check versions, no changes)"
        printf '\n'

        ui_section_bar "Recovery"
        ui_menu_item "7" "Rollback to previous version"
        ui_menu_item "8" "List backups"
        ui_menu_item "9" "Delete a backup"
        printf '\n'

        ui_section_bar "Options"
        ui_menu_item "t" "Theme picker"
        ui_menu_item "r" "Reset menu defaults"
        ui_menu_item "a" "About"
        ui_menu_item "e" "Exit"
        printf '\n'

        printf "${C_CYAN}> Select [1-9, t, r, a, e]: ${C_RESET}"
        read -r choice

        case "$choice" in
            1) CHANNEL="release";      return 0 ;;
            2) CHANNEL="beta";         return 0 ;;
            3) CHANNEL="edge";         return 0 ;;
            4) CHANNEL="development";  return 0 ;;
            5) FORCE=1; return 0 ;;
            6) DRY_RUN=1; return 0 ;;
            7) ROLLBACK=1; return 0 ;;
            8) LIST_BACKUPS=1; return 0 ;;
            9)
                list_backups
                printf "${C_CYAN}> Enter backup path (or 'all' to delete all, or blank to cancel): ${C_RESET}"
                read -r del_target
                if [ -z "$del_target" ]; then
                    ui_step "Delete backup cancelled."
                    continue
                fi
                DELETE_BACKUP="$del_target"
                return 0
                ;;
            t|T) show_theme_menu ;;
            r|R) reset_menu_defaults; ui_ok "Defaults reset." ;;
            a|A) show_about ;;
            e|E|c|C) ui_step "Exiting."; exit 0 ;;
            *) ui_warn "Please select 1-9, t, r, a, or e." ;;
        esac
    done
}



main() {
    theme_init
    trap cleanup EXIT
    trap on_interrupt INT TERM
    channel_load
    parse_args "$@"

    mkdir -p "$STATE_DIR" "$BACKUP_DIR"

    hr
    ui_step "${SCRIPT_NAME} v${SCRIPT_VERSION}"
    hr
    printf '\n'

    # Show main menu when run with no flags in a terminal
    local no_action=1
    [ "$FORCE" -eq 1 ]                && no_action=0
    [ "$DRY_RUN" -eq 1 ]              && no_action=0
    [ "$ROLLBACK" -eq 1 ]             && no_action=0
    [ "$LIST_BACKUPS" -eq 1 ]         && no_action=0
    [ -n "$DELETE_BACKUP" ]           && no_action=0
    [ "$MIGRATE_FROM_PACKAGE" -eq 1 ] && no_action=0

    if [ "$no_action" -eq 1 ] && [ "$ASSUME_YES" -eq 0 ] && is_tty; then
        show_main_menu
    fi

    if [ "$LIST_BACKUPS" -eq 1 ]; then
        list_backups
        exit 0
    fi

    if [ -n "$DELETE_BACKUP" ]; then
        do_delete_backup "$DELETE_BACKUP"
        exit 0
    fi

    if [ "$ROLLBACK" -eq 1 ]; then
        do_rollback "$ROLLBACK_FILE"
        exit 0
    fi

    if [ "$MIGRATE_FROM_PACKAGE" -eq 1 ]; then
        require_root_openwrt
        detect_agh_install
        detect_pkg_manager
        detect_downloader
        detect_arch
        get_latest_version

        local free_kb free_mb
        free_kb="$(df /tmp | awk 'NR==2 {print $4}')"
        free_mb=$(( free_kb / 1024 ))
        [ "$free_mb" -ge "$MIN_FREE_MB" ] || die "Insufficient free space in /tmp. Need ${MIN_FREE_MB} MB, have ${free_mb} MB."

        validate_migration_preconditions
        get_current_version
        confirm_migration
        do_migrate_from_package
        exit 0
    fi

    preflight_update
    show_preflight

    if [ "$DRY_RUN" -eq 1 ]; then
        hr
        ui_step "Dry run only. No changes made."
        box \
            "Install directory: ${AGH_DIR}" \
            "Binary:            ${AGH_BINARY}" \
            "Config:            ${AGH_CONFIG:-not found}" \
            "DNS port:          $(get_dns_port)" \
            "Current version:   ${CURRENT_VERSION}" \
            "Latest version:    ${LATEST_VERSION}" \
            "Arch tarball:      AdGuardHome_linux_${AGH_ARCH}.tar.gz"
        printf '\n'
        if is_update_needed; then
            if latest_version_is_placeholder; then
                ui_step "Latest ${CHANNEL} channel tarball available (installed: ${CURRENT_VERSION})."
            else
                ui_step "Update available: ${CURRENT_VERSION} -> ${LATEST_VERSION}"
            fi
        else
            ui_ok "Already on latest version (${CURRENT_VERSION})."
        fi
        printf '\n'
        exit 0
    fi

    if ! is_update_needed; then
        ui_ok "Already on latest version (${CURRENT_VERSION}). Use --force to reinstall."
        [ "$PERSIST_SYSUPGRADE" -eq 1 ] && ensure_sysupgrade_persistence
        exit 0
    fi

    confirm_update

    ui_step "Update: ${CURRENT_VERSION} -> ${LATEST_VERSION}"
    printf '\n'

    backup_current
    download_release
    install_binary
    verify_install
    channel_save
    [ "$PERSIST_SYSUPGRADE" -eq 1 ] && ensure_sysupgrade_persistence
    cleanup

    hr
    ui_ok "AdGuardHome updated to $(display_installed_version)."
    show_web_access_url
    ui_step "Rollback if needed: ${SCRIPT_NAME} --rollback"
    printf '\n'
}

main "$@"
