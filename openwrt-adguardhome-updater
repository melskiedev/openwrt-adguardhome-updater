#!/bin/sh
# openwrt-adguardhome-updater
#
# Vanilla OpenWrt AdGuard Home updater for manual binary installs.
#
# Supports:
# - OpenWrt 25.12+ using apk
# - OpenWrt 24.10 and older using opkg
#
# What it does:
# - Detects AdGuardHome install path from running process, known locations,
#   or --install-dir override
# - Detects CPU architecture and maps to AdGuardHome release asset name
# - Guards against package-managed installs (apk/opkg)
# - Fetches latest stable version from GitHub releases API
# - Backs up full install directory before any change
# - Replaces only the binary; config, data, and blocklists are preserved
# - Validates DNS health after update (process + port + resolution)
# - Auto-rollbacks on failed health check
# - Adds key paths to /etc/sysupgrade.conf
#
# What it does NOT do:
# - Does not modify AdGuardHome config or settings
# - Does not update package-managed AdGuardHome installs directly.
#   Package-managed installs can be converted to standalone binaries
#   using --migrate-from-package (or --migrate-from-apk / --migrate-from-opkg).
# - Should not be run as a cron job (briefly stops DNS)

SCRIPT_VERSION="2026.06.18.01"
SCRIPT_NAME="openwrt-adguardhome-updater"

STATE_DIR="/root/adguardhome-updater"
THEME_FILE="${STATE_DIR}/theme.conf"
THEME_NAME="classic"
CHANNEL_FILE="${STATE_DIR}/channel.conf"
CHANNEL="release"
DETECTED_CHANNEL="unknown"

AGH_DIR=""
AGH_BINARY=""
AGH_INIT=""
AGH_CONFIG=""
AGH_RELEASES_URL="https://api.github.com/repos/AdguardTeam/AdGuardHome/releases/latest"
AGH_DOWNLOAD_BASE="https://github.com/AdguardTeam/AdGuardHome/releases/download"
AGH_STATIC_BASE="https://static.adtidy.org/adguardhome"

INSTALL_DIR_OVERRIDE=""

BACKUP_DIR="${STATE_DIR}/backups"
TMP_DIR="/tmp/adguardhome-updater"
TMP_TARBALL="${TMP_DIR}/AdGuardHome.tar.gz"
TMP_EXTRACT="${TMP_DIR}/extract"

MIN_FREE_MB=60

DRY_RUN=0
FORCE=0
KEEP_TMP=0
ROLLBACK=0
ROLLBACK_FILE=""
LIST_BACKUPS=0
DELETE_BACKUP=""
ASSUME_YES=0
PERSIST_SYSUPGRADE=1
MIGRATE_FROM_PACKAGE=0
CONFIRMED_LAN=0

PKG_MANAGER="unknown"
AGH_PKG_NAME=""
AGH_ARCH=""
BACKUP_FILE_CREATED=""
CURRENT_VERSION=""
LATEST_VERSION=""
OWRT_VER=""
FREE_MB=0
DOWNLOADER=""
CLEANUP_RAN=0


# ──────────────────────────────────────────────────────────────
# Theme system
# ──────────────────────────────────────────────────────────────

C_RESET=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''; C_DIM=''; C_BOLD=''
UI_BAR=''; UI_KEY=''; UI_TITLE=''; UI_HINT=''
USE_UNICODE=0

theme_is_valid() {
    case "$1" in
        classic|green|amber|ocean|mono) return 0 ;;
        *) return 1 ;;
    esac
}

theme_can_color() {
    [ -t 1 ] || return 1
    [ "${TERM:-dumb}" = "dumb" ] && return 1
    [ -n "${NO_COLOR:-}" ] && return 1
    return 0
}

theme_apply() {
    local requested="$1"
    local render="$requested"
    if [ "$render" != "mono" ] && ! theme_can_color; then
        render="mono"
    fi

    case "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" in
        *UTF-8*|*utf-8*|*utf8*) USE_UNICODE=1 ;;
        *) USE_UNICODE=0 ;;
    esac

    local e
    e="$(printf '\033')"

    case "$render" in
        green)
            C_RESET="${e}[0m"; C_RED="${e}[0;31m"; C_GREEN="${e}[0;32m"
            C_YELLOW="${e}[1;33m"; C_CYAN="${e}[0;36m"; C_DIM="${e}[0;37m"; C_BOLD="${e}[1m"
            UI_BAR="${e}[30;42m"; UI_KEY="${e}[30;41m"; UI_TITLE="${e}[1;37m"; UI_HINT="${e}[0;36m"
            ;;
        amber)
            C_RESET="${e}[0m"; C_RED="${e}[0;31m"; C_GREEN="${e}[0;33m"
            C_YELLOW="${e}[1;33m"; C_CYAN="${e}[0;33m"; C_DIM="${e}[0;37m"; C_BOLD="${e}[1m"
            UI_BAR="${e}[30;43m"; UI_KEY="${e}[30;47m"; UI_TITLE="${e}[1;33m"; UI_HINT="${e}[0;33m"
            ;;
        ocean)
            C_RESET="${e}[0m"; C_RED="${e}[0;31m"; C_GREEN="${e}[0;36m"
            C_YELLOW="${e}[1;36m"; C_CYAN="${e}[1;34m"; C_DIM="${e}[0;37m"; C_BOLD="${e}[1m"
            UI_BAR="${e}[37;44m"; UI_KEY="${e}[30;46m"; UI_TITLE="${e}[1;36m"; UI_HINT="${e}[0;36m"
            ;;
        mono)
            C_RESET=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''; C_DIM=''; C_BOLD=''
            UI_BAR=''; UI_KEY=''; UI_TITLE=''; UI_HINT=''
            ;;
        classic|*)
            C_RESET="${e}[0m"; C_RED="${e}[0;31m"; C_GREEN="${e}[0;32m"
            C_YELLOW="${e}[0;33m"; C_CYAN="${e}[0;36m"; C_DIM="${e}[0;37m"; C_BOLD="${e}[1m"
            UI_BAR="${e}[30;47m"; UI_KEY="${e}[37;44m"; UI_TITLE="${e}[1m"; UI_HINT="${e}[0;37m"
            ;;
    esac
}

theme_load() {
    THEME_NAME="classic"
    [ -f "$THEME_FILE" ] || return 0
    local saved
    saved="$(sed -n 's/^THEME=//p' "$THEME_FILE" | head -n 1)"
    theme_is_valid "$saved" && THEME_NAME="$saved"
}

theme_save() {
    mkdir -p "$STATE_DIR"
    printf 'THEME=%s\n' "$THEME_NAME" > "$THEME_FILE"
}

theme_init() {
    theme_load
    theme_apply "$THEME_NAME"
}


# ──────────────────────────────────────────────────────────────
# Channel persistence
# ──────────────────────────────────────────────────────────────

channel_is_valid() {
    case "$1" in
        release|beta|edge|development) return 0 ;;
        *) return 1 ;;
    esac
}

channel_load() {
    CHANNEL="release"
    [ -f "$CHANNEL_FILE" ] || return 0
    local saved
    saved="$(sed -n 's/^CHANNEL=//p' "$CHANNEL_FILE" | head -n 1)"
    channel_is_valid "$saved" && CHANNEL="$saved"
}

channel_save() {
    mkdir -p "$STATE_DIR"
    printf 'CHANNEL=%s\n' "$CHANNEL" > "$CHANNEL_FILE"
}

detect_channel_from_version() {
    local ver="$1"
    case "$ver" in
        *-b.*|*beta*)       echo "beta" ;;
        *edge*)             echo "edge" ;;
        *dev*|*development*) echo "development" ;;
        v[0-9]*.[0-9]*.[0-9]*) echo "release" ;;
        *)                  echo "unknown" ;;
    esac
}


# ──────────────────────────────────────────────────────────────
# UI helpers
# ──────────────────────────────────────────────────────────────

is_tty() {
    [ -t 0 ] && [ -t 1 ]
}

hr() {
    if [ "${USE_UNICODE:-0}" -eq 1 ]; then
        printf '══════════════════════════════════════════════════════════════════════\n'
    else
        printf '======================================================================\n'
    fi
}

box() {
    if [ "${USE_UNICODE:-0}" -eq 1 ]; then
        printf '┌──────────────────────────────────────────────────────────────────┐\n'
        while [ $# -gt 0 ]; do
            printf '│ %-68s │\n' "$1"; shift
        done
        printf '└──────────────────────────────────────────────────────────────────┘\n'
    else
        printf '+------------------------------------------------------------------+\n'
        while [ $# -gt 0 ]; do
            printf '| %-64s |\n' "$1"; shift
        done
        printf '+------------------------------------------------------------------+\n'
    fi
}

ui_ok()   { printf "${C_GREEN}[OK]${C_RESET} %s\n" "$*"; }
ui_warn() { printf "${C_YELLOW}[!]${C_RESET} %s\n" "$*"; }
ui_step() { printf "${C_DIM}[->]${C_RESET} %s\n" "$*"; }
ui_err()  { printf "${C_RED}[ERROR]${C_RESET} %s\n" "$*"; }

ui_section_bar() {
    if [ -n "$UI_BAR" ]; then
        printf "${UI_BAR} %-68s ${C_RESET}\n" "$1"
    else
        printf '== %s ==\n' "$1"
    fi
}

ui_menu_item() {
    local key="$1" text="$2" hint="${3:-}"
    if [ -n "$UI_KEY" ]; then
        printf "  ${UI_KEY} %s ${C_RESET}  %s" "$key" "$text"
    else
        printf "  [%s]  %s" "$key" "$text"
    fi
    [ -n "$hint" ] && printf "  ${C_DIM}%s${C_RESET}" "$hint"
    printf '\n'
}

confirm() {
    local question="$1" default="${2:-n}" answer prompt

    [ "$ASSUME_YES" -eq 1 ] && return 0
    if ! is_tty; then
        die "Not running in a terminal. Use --yes to proceed without prompts."
    fi
    [ "$default" = "y" ] && prompt="Y/n" || prompt="y/N"
    while true; do
        printf "${C_CYAN}> %s (%s) ${C_RESET}" "$question" "$prompt"
        read -r answer
        [ -n "$answer" ] || answer="$default"
        case "$answer" in
            y|Y|yes|YES) return 0 ;;
            n|N|no|NO)   return 1 ;;
            *) ui_warn "Please answer y or n." ;;
        esac
    done
}

log() {
    local level="$1"; shift
    local msg="$*"
    case "$level" in
        INFO)    ui_step "$msg" ;;
        SUCCESS) ui_ok   "$msg" ;;
        WARN)    ui_warn "$msg" ;;
        ERROR)   ui_err  "$msg" ;;
        *)       printf "[%s] %s\n" "$SCRIPT_NAME" "$msg" ;;
    esac
}

cleanup() {
    [ "$CLEANUP_RAN" -eq 1 ] && return
    CLEANUP_RAN=1
    if [ "$KEEP_TMP" -eq 0 ] && [ -d "$TMP_DIR" ]; then
        rm -rf "$TMP_DIR"
    fi
}

on_interrupt() {
    ui_err "Interrupted."
    cleanup
    exit 130
}

die() {
    ui_err "$*"
    cleanup
    exit 1
}


# ──────────────────────────────────────────────────────────────
# Usage
# ──────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [options]

  (no flags)              Open menu
  --dry-run               Check current vs latest version, make no changes
  --force                 Reinstall even if already on latest version
  --yes | -y              Skip confirmation prompts
  --no-persist            Skip adding paths to /etc/sysupgrade.conf
  --keep-tmp              Do not delete /tmp download files after install
  --install-dir <path>    Override detected install directory
  --channel <name>        Set release channel: release, beta, edge, development (default: release)
  --reset-channel         Reset saved channel to release
  --theme <name>          Set UI theme: classic, green, amber, ocean, mono
  --reset-theme           Reset saved theme to classic
  --rollback              Restore the latest backup
  --rollback <file>       Restore a specific backup file
  --list-backups          List available backups
  --delete-backup <file>  Delete a specific backup file
  --delete-backup all     Delete all backups
  --migrate-from-package  Convert package-managed AdGuardHome to standalone binary
  --migrate-from-apk      Alias for --migrate-from-package
  --migrate-from-opkg     Alias for --migrate-from-package
    --yes-i-have-lan-access   Required confirmation for migration (DNS drops briefly)
  --help                  Show this help

Examples:
  ${SCRIPT_NAME}
  ${SCRIPT_NAME} --dry-run
  ${SCRIPT_NAME} --yes
  ${SCRIPT_NAME} --rollback
  ${SCRIPT_NAME} --migrate-from-package --yes-i-have-lan-access
  ${SCRIPT_NAME} --migrate-from-apk --yes-i-have-lan-access
  ${SCRIPT_NAME} --migrate-from-opkg --yes-i-have-lan-access
EOF
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run)         DRY_RUN=1 ;;
            --force)           FORCE=1 ;;
            --keep-tmp)        KEEP_TMP=1 ;;
            --channel)
                [ -n "$2" ] || die "--channel requires a value: release, beta, edge, development"
                case "$2" in
                    release|beta|edge|development) CHANNEL="$2" ;;
                    *) die "Unknown channel: $2. Valid channels: release, beta, edge, development" ;;
                esac
                shift
                ;;
            --reset-channel)
                CHANNEL="release"
                channel_save
                ui_ok "Channel reset to release."
                exit 0
                ;;
            --yes|-y)          ASSUME_YES=1 ;;
            --no-persist)      PERSIST_SYSUPGRADE=0 ;;
            --theme)
                [ -n "$2" ] || die "--theme requires a value: classic, green, amber, ocean, mono"
                theme_is_valid "$2" || die "Unknown theme: $2. Valid: classic, green, amber, ocean, mono"
                THEME_NAME="$2"
                theme_save
                theme_apply "$THEME_NAME"
                ui_ok "Theme set: ${THEME_NAME}"
                shift
                ;;
            --reset-theme)
                THEME_NAME="classic"
                theme_save
                theme_apply "classic"
                ui_ok "Theme reset to classic."
                exit 0
                ;;
            --list-backups)    LIST_BACKUPS=1 ;;
            --install-dir)
                [ -n "$2" ] || die "--install-dir requires a path argument."
                INSTALL_DIR_OVERRIDE="$2"
                shift
                ;;
            --delete-backup)
                [ -n "$2" ] || die "--delete-backup requires a backup file path or 'all'."
                DELETE_BACKUP="$2"
                shift
                ;;
            --rollback)
                ROLLBACK=1
                if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
                    ROLLBACK_FILE="$2"
                    shift
                fi
                ;;
            --migrate-from-package|--migrate-from-apk|--migrate-from-opkg)
                MIGRATE_FROM_PACKAGE=1 ;;
            --yes-i-have-lan-access) CONFIRMED_LAN=1 ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                die "Unknown argument: $1. Use --help for usage."
                ;;
        esac
        shift
    done
}


# ──────────────────────────────────────────────────────────────
# Detection
# ──────────────────────────────────────────────────────────────

require_root_openwrt() {
    [ "$(id -u)" -eq 0 ] || die "Must be run as root."
    [ -f /etc/openwrt_release ] || die "This script is intended for OpenWrt only."
}

detect_arch() {
    local cpu_arch
    cpu_arch="$(uname -m)"

    case "$cpu_arch" in
        aarch64|arm64)   AGH_ARCH="arm64" ;;
        armv8l|armv7l)   AGH_ARCH="armv7" ;;
        armv6l)          AGH_ARCH="armv6" ;;
        armv5l)          AGH_ARCH="armv5" ;;
        x86_64|amd64)    AGH_ARCH="amd64" ;;
        i386|i486|i686|i786) AGH_ARCH="386" ;;
        riscv64)         AGH_ARCH="riscv64" ;;
        mips|mips64)
            # Use hexdump for reliable endian detection (matches official install.sh)
            local endian_result
            if command -v hexdump >/dev/null 2>&1; then
                endian_result="$(printf 'I' | hexdump -o | awk '{ print substr($2, 6, 1); exit; }')"
                if [ "$endian_result" -eq 1 ] 2>/dev/null; then
                    AGH_ARCH="${cpu_arch}le_softfloat"
                else
                    AGH_ARCH="${cpu_arch}_softfloat"
                fi
            else
                # Fallback to /proc/cpuinfo if hexdump unavailable
                if grep -qiE "mips.*el|mipsel|mipsle" /proc/cpuinfo 2>/dev/null; then
                    AGH_ARCH="${cpu_arch}le_softfloat"
                else
                    AGH_ARCH="${cpu_arch}_softfloat"
                fi
            fi
            ;;
        mipsel) AGH_ARCH="mipsle_softfloat" ;;
        *)      die "Unsupported CPU architecture: ${cpu_arch}" ;;
    esac
}

detect_agh_install() {
    if [ -n "$INSTALL_DIR_OVERRIDE" ]; then
        [ -d "$INSTALL_DIR_OVERRIDE" ] || die "--install-dir path does not exist: ${INSTALL_DIR_OVERRIDE}"
        AGH_DIR="$INSTALL_DIR_OVERRIDE"
        AGH_BINARY="${AGH_DIR}/AdGuardHome"
        [ -x "$AGH_BINARY" ] || die "AdGuardHome binary not found or not executable at ${AGH_BINARY}"
    else
        local pid proc_path candidate
        pid="$(pidof AdGuardHome 2>/dev/null | awk '{print $1}')"
        if [ -n "$pid" ]; then
            proc_path="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)"
            if [ -n "$proc_path" ] && [ -x "$proc_path" ]; then
                AGH_BINARY="$proc_path"
                AGH_DIR="$(dirname "$proc_path")"
            fi
        fi

        if [ -z "$AGH_DIR" ]; then
            for candidate in /etc/AdGuardHome /opt/AdGuardHome /usr/local/AdGuardHome; do
                if [ -x "${candidate}/AdGuardHome" ]; then
                    AGH_DIR="$candidate"
                    AGH_BINARY="${AGH_DIR}/AdGuardHome"
                    break
                fi
            done
        fi

        # Check /usr/bin/AdGuardHome as a standalone binary (not a dir-based install)
        if [ -z "$AGH_DIR" ] && [ -x "/usr/bin/AdGuardHome" ]; then
            AGH_BINARY="/usr/bin/AdGuardHome"
            AGH_DIR="/usr/bin"
            ui_warn "AdGuardHome found at /usr/bin/AdGuardHome. Use --install-dir if config is elsewhere."
        fi

        [ -n "$AGH_DIR" ] || die "Could not detect AdGuardHome install directory. Use --install-dir."
    fi

    if [ -f "${AGH_DIR}/AdGuardHome.yaml" ]; then
        AGH_CONFIG="${AGH_DIR}/AdGuardHome.yaml"
    elif [ -f "${AGH_DIR}/config.yaml" ]; then
        AGH_CONFIG="${AGH_DIR}/config.yaml"
    elif [ -f "/etc/adguardhome.yaml" ]; then
        # Fallback for opkg-style installs that place config at a flat path
        AGH_CONFIG="/etc/adguardhome.yaml"
    fi

    local init_candidate
    for init_candidate in /etc/init.d/adguardhome /etc/init.d/AdGuardHome; do
        if [ -x "$init_candidate" ]; then
            AGH_INIT="$init_candidate"
            break
        fi
    done

    [ -n "$AGH_INIT" ] || die "Could not find AdGuardHome init script."
}

detect_pkg_manager() {
    if command -v apk >/dev/null 2>&1; then
        PKG_MANAGER="apk"
    elif command -v opkg >/dev/null 2>&1; then
        PKG_MANAGER="opkg"
    else
        PKG_MANAGER="unknown"
    fi
}

check_agh_pkg_managed() {
    local pkg_managed=0
    case "$PKG_MANAGER" in
        apk)
            if apk info 2>/dev/null | grep -Eiq '^adguardhome$|^adguard-home$'; then
                pkg_managed=1
            fi
            ;;
        opkg)
            if opkg list-installed 2>/dev/null | awk '{print $1}' | grep -Eiq '^adguardhome$|^adguard-home$'; then
                pkg_managed=1
            fi
            ;;
    esac

    if [ "$pkg_managed" -eq 1 ]; then
        ui_err "AdGuardHome appears to be managed by ${PKG_MANAGER}."
        ui_err "This updater is for manual binary installs only."
        printf '\n'
        case "$PKG_MANAGER" in
            apk)
                ui_step "To update via package manager:  apk update && apk upgrade adguardhome"
                ui_step "To migrate to upstream binaries: ${SCRIPT_NAME} --migrate-from-apk --yes-i-have-lan-access"
                ;;
            opkg)
                ui_step "To update via package manager:  opkg update && opkg upgrade adguardhome"
                ui_step "To migrate to upstream binaries: ${SCRIPT_NAME} --migrate-from-opkg --yes-i-have-lan-access"
                ;;
        esac
        printf '\n'
        exit 1
    fi
}

get_current_version() {
    if [ ! -x "$AGH_BINARY" ]; then
        CURRENT_VERSION="not installed"
        DETECTED_CHANNEL="unknown"
        return
    fi
    CURRENT_VERSION="$("$AGH_BINARY" --version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1)"
    [ -n "$CURRENT_VERSION" ] || CURRENT_VERSION="unknown"
    DETECTED_CHANNEL="$(detect_channel_from_version "$CURRENT_VERSION")"
}

get_latest_version() {
    local response version_url

    case "$CHANNEL" in
        development|beta|edge)
            # Best-effort version fetch. The official installer does not require
            # version.json and downloads the channel tarball directly.
            # If version.json is unavailable, fall back to the channel name.
            version_url="${AGH_STATIC_BASE}/${CHANNEL}/version.json"
            response="$(http_get "$version_url" 2>/dev/null || true)"
            LATEST_VERSION="$(printf '%s' "$response" \
                | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' \
                | head -1 \
                | sed 's/.*"version"[[:space:]]*:[[:space:]]*"//;s/".*//')"
            [ -n "$LATEST_VERSION" ] || LATEST_VERSION="$CHANNEL"
            ;;
        release|*)
            response="$(http_get "$AGH_RELEASES_URL")"
            [ -n "$response" ] || die "Failed to fetch latest release info from GitHub API."
            LATEST_VERSION="$(printf '%s' "$response" \
                | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
                | head -1 \
                | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+')"
            [ -n "$LATEST_VERSION" ] || die "Could not parse latest stable version from GitHub API response."
            ;;
    esac
}

get_dns_port() {
    if [ -n "$AGH_CONFIG" ] && [ -f "$AGH_CONFIG" ]; then
        local parsed
        parsed="$(
            awk '
                /^[[:space:]]*dns:[[:space:]]*$/ {in_dns=1; next}
                /^[^[:space:]][^:]*:[[:space:]]*$/ && in_dns {in_dns=0}
                in_dns && /^[[:space:]]*port:[[:space:]]*[0-9]+/ {
                    gsub(/[^0-9]/, "", $2)
                    print $2
                    exit
                }
            ' "$AGH_CONFIG" 2>/dev/null | grep -E '^[0-9]+$' | head -1
        )"
        if [ -n "$parsed" ]; then
            echo "$parsed"
            return
        fi
    fi
    echo "3053"
}

get_web_port() {
    if [ -n "$AGH_CONFIG" ] && [ -f "$AGH_CONFIG" ]; then
        local parsed
        parsed="$(
            awk '
                /^[[:space:]]*http:[[:space:]]*$/ {in_http=1; next}
                /^[^[:space:]][^:]*:[[:space:]]*$/ && in_http {in_http=0}
                in_http && /^[[:space:]]*address:[[:space:]]/ {
                    line=$0
                    gsub(/["'"'"' ]/, "", line)
                    sub(/^[[:space:]]*address:/, "", line)
                    if (line ~ /\]:[0-9]+$/) {
                        sub(/^.*\]:/, "", line)
                        print line
                        exit
                    }
                    if (line ~ /:[0-9]+$/) {
                        sub(/^.*:/, "", line)
                        print line
                        exit
                    }
                }
            ' "$AGH_CONFIG" 2>/dev/null | grep -E '^[0-9]+$' | head -1
        )"
        if [ -n "$parsed" ]; then
            echo "$parsed"
            return
        fi
    fi
    echo "3000"
}

show_web_access_url() {
    local web_port lan_dev lan_ip
    web_port="$(get_web_port)"

    # 1. Try ubus to get the actual LAN L3 device (most reliable on OpenWrt)
    lan_dev="$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
    if [ -n "$lan_dev" ]; then
        lan_ip="$(ip -4 addr show "$lan_dev" 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')"
    fi

    # 2. Fall back to br-lan directly
    if [ -z "$lan_ip" ]; then
        lan_ip="$(ip -4 addr show br-lan 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')"
    fi

    # 3. Fall back to any non-loopback IPv4
    if [ -z "$lan_ip" ]; then
        lan_ip="$(ip -4 addr show 2>/dev/null | awk '/inet / && !/127\.0\.0\.1/ {sub(/\/.*/, "", $2); print $2; exit}')"
    fi

    printf '\n'
    if [ -n "$lan_ip" ]; then
        ui_ok "AdGuardHome web interface: ${C_CYAN}http://${lan_ip}:${web_port}/${C_RESET}"
    else
        ui_ok "AdGuardHome web interface: http://<router-ip>:${web_port}/"
    fi
}


# ──────────────────────────────────────────────────────────────
# Downloader
# ──────────────────────────────────────────────────────────────

detect_downloader() {
    # Prefer curl. Fall back to wget only if HTTPS-capable.
    if command -v curl >/dev/null 2>&1; then
        DOWNLOADER="curl"
        return 0
    fi

    if command -v wget >/dev/null 2>&1; then
        # Check if wget supports HTTPS by probing its help output.
        # wget-nossl does not list 'https' in its help and cannot fetch HTTPS URLs.
        if wget --help 2>&1 | grep -qi 'https'; then
            DOWNLOADER="wget"
            return 0
        else
            die "wget on this system does not support HTTPS (wget-nossl detected). Install curl: apk add curl"
        fi
    fi

    die "No suitable downloader found. Install curl: apk add curl"
}

# Unified download wrapper. Usage: http_get <url> [output_file]
# If output_file is omitted, writes to stdout.
http_get() {
    local url="$1"
    local out="${2:-}"

    case "$DOWNLOADER" in
        curl)
            if [ -n "$out" ]; then
                curl -fsSL "$url" -o "$out"
            else
                curl -fsSL "$url"
            fi
            ;;
        wget)
            if [ -n "$out" ]; then
                wget -q -O "$out" "$url"
            else
                wget -q -O - "$url"
            fi
            ;;
        *)
            die "No downloader configured. Run detect_downloader first."
            ;;
    esac
}


# ──────────────────────────────────────────────────────────────
# Preflight
# ──────────────────────────────────────────────────────────────

preflight_common() {
    require_root_openwrt
    detect_agh_install
}

preflight_update() {
    require_root_openwrt

    OWRT_VER="$(grep DISTRIB_RELEASE /etc/openwrt_release | cut -d= -f2 | tr -d '"')"

    detect_agh_install
    detect_pkg_manager
    check_agh_pkg_managed

    detect_downloader

    for dep in tar gzip; do
        command -v "$dep" >/dev/null 2>&1 || die "Required dependency not found: ${dep}"
    done

    if [ ! -f /etc/ssl/certs/ca-certificates.crt ] && [ ! -f /etc/ssl/cert.pem ] && [ ! -d /etc/ssl/certs ]; then
        ui_warn "CA certificate bundle not found. HTTPS downloads may fail."
        ui_warn "Install ca-bundle with your package manager if downloads fail."
    fi

    local free_kb
    free_kb="$(df /tmp | awk 'NR==2 {print $4}')"
    FREE_MB=$(( free_kb / 1024 ))
    [ "$FREE_MB" -ge "$MIN_FREE_MB" ] || die "Insufficient free space in /tmp. Need ${MIN_FREE_MB} MB, have ${FREE_MB} MB."

    detect_arch
    get_current_version
    get_latest_version
}


